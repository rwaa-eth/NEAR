<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/center_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/center_gps"
        app:backgroundTint="@color/screen"
        app:fabCustomSize="52dp"
        app:maxImageSize="26dp"
        app:srcCompat="@drawable/ic_gps"
        app:tint="@color/ink" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/vertex_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="112dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="@string/mark_corner"
        android:visibility="gone"
        app:backgroundTint="@color/ink"
        app:fabCustomSize="56dp"
        app:maxImageSize="22dp"
        app:srcCompat="@drawable/ic_vertex"
        app:tint="@android:color/white" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/walk_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:contentDescription="@string/start_walk"
        app:backgroundTint="@color/walk_go"
        app:fabCustomSize="72dp"
        app:maxImageSize="28dp"
        app:srcCompat="@drawable/ic_play"
        app:tint="@android:color/white" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hold_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:cardBackgroundColor="@color/screen"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:minWidth="220dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/hold_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/hold_still"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/hold_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/walk_go"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
