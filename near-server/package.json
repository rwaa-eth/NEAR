{
  "name": "rwaa-near-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && npm run build:wallet",
    "build:wallet": "esbuild client/wallet.ts --bundle --format=esm --platform=browser --outfile=public/wallet.js --external:near-api-js",
    "start": "node dist/index.js",
    "fund": "tsx script/fund-usdt.ts",
    "signup-key": "tsx script/signup-key.ts",
    "test": "tsx --test test/accountId.test.ts test/geo.test.ts test/api.test.ts test/ethw.test.ts test/escrow.test.ts test/otp.test.ts test/payee.test.ts test/config.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@omni-bridge/core": "^0.21.0",
    "@omni-bridge/near": "^0.21.0",
    "@scure/base": "^1.2.4",
    "@simplewebauthn/server": "11.0.0",
    "better-sqlite3": "^11.8.1",
    "cbor-x": "^1.6.0",
    "esbuild": "^0.25.10",
    "fastify": "^5.2.1",
    "jsqr": "^1.4.0",
    "near-api-js": "^5.1.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
