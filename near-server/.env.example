PORT=8099
STATIC_API_TOKEN=dev-token-change-me
RP_ID=rwaa.percolate.one
ORIGIN=https://rwaa.percolate.one
SQLITE_PATH=data/rwaa.sqlite
PACKAGE_NAME=one.percolate.rwaa
# Colon-separated SHA-256 of the Android signing cert. Also becomes the passkey origin.
SHA256_CERT_FINGERPRINT=
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_FAUCET_URL=https://helper.nearprotocol.com/account
# Create a testnet account for each new email. The browser keeps the secret key.
NEAR_PROVISION_ACCOUNTS=true
NEAR_RELAYER_ACCOUNT=
NEAR_RELAYER_KEY=
# NEP-141 test token and the escrow contract. Both are account ids, not 0x addresses.
NEAR_TOKEN_ACCOUNT=
NEAR_TOKEN_SYMBOL=USDT
NEAR_TOKEN_DECIMALS=6
NEAR_ESCROW_ACCOUNT=
# Owner of the escrow. This key calls release. secp256k1:…, ed25519:…, or 0x + 32-byte hex.
# Do not commit the key.
NEAR_OPERATOR_ACCOUNT=
NEAR_OPERATOR_KEY=
# Email OTP for wallet creation. Prefer Resend with a verified raopenwallet.org domain.
# EMAIL_FROM=RaOpenwallet <noreply@raopenwallet.org>
# RESEND_API_KEY=
# Or use SMTP: SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_DEV_MODE=true logs the code and returns it as devCode (tests / local only).
EMAIL_FROM=RaOpenwallet <noreply@raopenwallet.org>
RESEND_API_KEY=
SMTP_URL=
EMAIL_DEV_MODE=false
