# One process, one network. Passkeys are tied to RP_ID, which must be this host or its parent.
# test-evm.raopenwallet.org  Base Sepolia testnet  EVM_NETWORK=testnet  RP_ID=test-evm.raopenwallet.org
# A Base mainnet instance is a second process: EVM_NETWORK=mainnet and its own ORIGIN, RP_ID, and SQLITE_PATH.
PORT=8098
STATIC_API_TOKEN=dev-token-change-me
RP_ID=test-evm.raopenwallet.org
ORIGIN=https://test-evm.raopenwallet.org
SQLITE_PATH=data/rwaa.sqlite
PACKAGE_NAME=one.percolate.rwaa
# Colon-separated SHA-256 of the Android signing cert. Also becomes the passkey origin.
SHA256_CERT_FINGERPRINT=
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_RELAYER_ACCOUNT=
NEAR_RELAYER_KEY=
# mainnet = Base (chain 8453). testnet = Base Sepolia (chain 84532).
# Mainnet RPC default is https://mainnet.base.org when BASE_RPC_URL is empty.
EVM_NETWORK=testnet
# Base Sepolia passkey wallet. Deploy test USDT with: npm run deploy:usdt
# Mint into a wallet with: npm run fund -- 0xWallet 1000
BASE_RPC_URL=https://sepolia.base.org
ERC20_ADDRESS=
ERC20_SYMBOL=USDT
# Set true when BASE_RPC_URL is a Coinbase Developer RPC that sponsors Base Sepolia user operations.
BASE_PAYMASTER=false
# Email escrow. Deploy with: npx tsx script/deploy-escrow.ts
# ESCROW_OPERATOR_KEY calls release. It must hold Base Sepolia ETH. Do not commit the key.
ESCROW_ADDRESS=
ESCROW_OPERATOR_KEY=
# Email OTP for wallet creation. Prefer Resend with a verified raopenwallet.org domain.
# EMAIL_FROM=RaOpenwallet <noreply@raopenwallet.org>
# RESEND_API_KEY=
# Or use SMTP: SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_DEV_MODE=true logs the code and returns it as devCode (tests / local only).
EMAIL_FROM=RaOpenwallet <noreply@raopenwallet.org>
RESEND_API_KEY=
SMTP_URL=
EMAIL_DEV_MODE=false
